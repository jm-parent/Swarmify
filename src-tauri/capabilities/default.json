{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-read-image",
    "allow-load-board",
    "allow-save-board",
    "allow-write-text-file",
    "allow-read-text-file",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-detect-clis",
    "allow-images-dir",
    "allow-import-image",
    "allow-save-image-bytes",
    "allow-save-sanitized-svg",
    "allow-copy-image-file",
    "allow-purge-unused-images",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-rename-workspace",
    "allow-mark-opened",
    "allow-delete-workspace"
  ]
}
